# Porta da API
PORT=3001
# Origem do client (CORS). Em produção, coloque o domínio do site (separe vários com vírgula).
CLIENT_ORIGIN=http://localhost:5173

# ── Firebase Admin (service account) ─────────────────────────────
# Opção 1: caminho para o JSON baixado no console do Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
# Opção 2 (útil em hospedagem): o JSON inteiro em uma linha
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Cloudinary (o SECRET fica SÓ aqui) ───────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Limite de upload em MB (mantenha igual a VITE_MAX_UPLOAD_MB no client)
MAX_UPLOAD_MB=10

# ── IA ───────────────────────────────────────────────────────────
# Provedor: gemini (Google, GRATUITO) ou anthropic (Claude, pago)
AI_PROVIDER=gemini
# Gemini: chave grátis em https://aistudio.google.com/apikey (só aqui no server!)
GEMINI_API_KEY=
# "gemini-flash-latest" aponta sempre para o modelo Flash atual (do plano gratuito)
GEMINI_MODEL=gemini-flash-latest
# Claude (opcional, pago): https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Usos da IA por pessoa por dia (controle de custo)
AI_DAILY_LIMIT=30

# ── Notificações (Web Push) e lembretes ──────────────────────────
# Gere as chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# URL do site (identifica quem envia as notificações)
VAPID_SUBJECT=https://dra-nathalia.onrender.com
# Segredo usado pelo agendador (GitHub Actions) em POST /api/cron/lembretes
CRON_SECRET=
