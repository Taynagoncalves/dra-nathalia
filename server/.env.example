# Porta da API
PORT=3001
# Origem do client (CORS). Em produção, coloque o domínio do site (separe vários com vírgula).
CLIENT_ORIGIN=http://localhost:5173

# ── Firebase Admin (service account) ─────────────────────────────
# Opção 1: caminho para o JSON baixado no console do Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
# Opção 2 (útil em hospedagem): o JSON inteiro em uma linha
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Cloudinary (o SECRET fica SÓ aqui) ───────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Limite de upload em MB (mantenha igual a VITE_MAX_UPLOAD_MB no client)
MAX_UPLOAD_MB=10

# ── IA (Etapa 2) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=30
