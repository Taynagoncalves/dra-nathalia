# ── Firebase (Console → Configurações do projeto → Seus apps → Web) ──
# Estas chaves são públicas por natureza; a segurança vem das firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── API (/server) ─────────────────────────────────────────────────
# Em desenvolvimento deixe vazio: o Vite redireciona /api para localhost:3001.
# Em produção, coloque a URL pública do server (ex.: https://api.meusite.com).
VITE_API_URL=

# Limite de upload em MB (mantenha igual a MAX_UPLOAD_MB no server)
VITE_MAX_UPLOAD_MB=10

# Nada de segredo aqui! O CLOUDINARY_API_SECRET fica só no server/.env.
