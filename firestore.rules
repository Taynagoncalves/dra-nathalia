rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Documento do usuário
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Subcoleções (projects, subjects, folders, materials, notes, questions,
      // attempts, quizzes, errors, studySessions, goals, events, notifications…)
      // e subcoleções aninhadas (ex.: materials/{id}/chunks).
      // Exceção: aiUsage, que só o server escreve (é o limite diário da IA).
      match /{collection}/{document=**} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && collection != 'aiUsage';
      }
    }

    // Etapa 3 (liveSessions) será adicionada aqui. Todo o resto é negado.
  }
}
