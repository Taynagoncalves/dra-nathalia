rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Documento do usuário
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Subcoleções (projects, subjects, folders, materials, notes, questions,
      // attempts, quizzes, errors, studySessions, goals, events, notifications…)
      // e subcoleções aninhadas (ex.: materials/{id}/chunks).
      // Exceção: aiUsage, que só o server escreve (é o limite diário da IA).
      match /{collection}/{document=**} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && collection != 'aiUsage';
      }
    }

    // Etapa 3 — "Tayna de verdade": sessão ao vivo com código.
    // Só quem tem o código (= ID do documento) consegue abrir; listar é proibido.
    match /liveSessions/{code} {
      function isOwnerOf(data) { return request.auth != null && data.ownerUid == request.auth.uid; }
      function active(data) { return data.status == 'ativa' && data.expiresAt > request.time; }

      allow get: if isOwnerOf(resource.data) || (request.auth != null && active(resource.data));
      allow list: if false;
      allow create: if false; // criada pelo server (POST /api/live)
      allow delete: if isOwnerOf(resource.data);
      allow update: if isOwnerOf(resource.data)
        || (request.auth != null && active(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'questions']));
    }

    // Todo o resto é negado.
  }
}
